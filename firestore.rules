rules_version = '2';

// Reglas de seguridad de Firestore, calcadas de las colecciones y el
// modelo de roles que ya usa la app (ver db/colecciones.js y
// sesion.js: admin / repartidor).
//
// Pega estas reglas en Firebase Console → Firestore Database → Reglas,
// o publícalas con Firebase CLI (firebase deploy --only firestore:rules).

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function esAdmin() {
      return autenticado() && perfil().role == 'admin';
    }

    function localidadDelRepartidor(localidadId) {
      return autenticado() && localidadId is string && localidadId != '' &&
        get(/databases/$(database)/documents/localidades/$(localidadId)).data.repartidorId == request.auth.uid;
    }

    function localidadAsignada(localidadId) {
      return localidadId is string && localidadId != '' &&
        get(/databases/$(database)/documents/localidades/$(localidadId)).data.repartidorId is string &&
        get(/databases/$(database)/documents/localidades/$(localidadId)).data.repartidorId != '';
    }

    function clienteDelRepartidor(clienteId) {
      return autenticado() && clienteId is string &&
        get(/databases/$(database)/documents/clientes/$(clienteId)).data.localidadId is string &&
        localidadDelRepartidor(get(/databases/$(database)/documents/clientes/$(clienteId)).data.localidadId);
    }

    function snapshotTarifaValido() {
      return !request.resource.data.keys().hasAll(['modoOperacion']) || request.resource.data.modoOperacion != 'agua_medidor' || (request.resource.data.keys().hasAll(['tarifaSnapshot']) && request.resource.data.tarifaSnapshot is map && request.resource.data.tarifaSnapshot.litrosPorUnidad > 0 && request.resource.data.tarifaSnapshot.incrementoContadorPorUnidad > 0 && request.resource.data.tarifaSnapshot.precioUnitario >= 0 && request.resource.data.tarifaSnapshot.unidadComercial is string);
    }

    // usuarios: cualquier autenticado puede leer (la app lo necesita para
    // nombres/roles); solo el propio usuario o un admin puede escribir su
    // documento; solo admin puede borrar.
    match /usuarios/{uid} {
      allow read: if autenticado();
      allow create: if autenticado() && (request.auth.uid == uid || esAdmin()) && request.resource.data.role in ['admin', 'repartidor'];
      allow update: if autenticado() && (request.auth.uid == uid || esAdmin()) && request.resource.data.role in ['admin', 'repartidor'];
      allow delete: if esAdmin();
    }

    // productos: catálogo operativo.
    match /productos/{id} {
      allow read, create, update: if autenticado();
      allow delete: if esAdmin();
    }
    match /clientes/{id} {
      // El cliente fijo es obligatorio dentro de una localidad. El
      // REPARTIDOR solo puede leer y actualizar clientes de sus localidades;
      // nunca puede cambiar la localidad asignada.
      allow read: if autenticado() && (esAdmin() || perfil().role != 'repartidor' || localidadDelRepartidor(resource.data.localidadId));
      allow create: if esAdmin() && localidadAsignada(request.resource.data.localidadId);
      allow update: if (esAdmin() && localidadAsignada(request.resource.data.localidadId)) || (perfil().role == 'repartidor' && localidadDelRepartidor(resource.data.localidadId) && request.resource.data.localidadId == resource.data.localidadId);
      allow delete: if esAdmin();
    }
    match /localidades/{id} {
      // Las localidades y sus asignaciones las define la Empresa.
      allow read: if autenticado();
      allow create, update, delete: if esAdmin();
    }
    match /vehiculos/{id} {
      // Catálogo separado; el repartidor solo consume la referencia.
      allow read: if autenticado();
      allow create, update, delete: if esAdmin();
    }
    match /medidores/{id} {
      // Catálogo separado; el repartidor solo consume la referencia.
      allow read: if autenticado();
      allow create, update, delete: if esAdmin();
    }

    // notas: ventas de agua medida — se conservan como registro inmutable.
    match /notas/{id} {
      allow read: if autenticado() && (esAdmin() || resource.data.capturadoPorUid == request.auth.uid || resource.data.repartidorId == request.auth.uid);
      allow create: if snapshotTarifaValido() && (esAdmin() || (autenticado() && request.resource.data.capturadoPorUid == request.auth.uid && request.resource.data.jornadaId is string && request.resource.data.jornadaId != '' && get(/databases/$(database)/documents/jornadas/$(request.resource.data.jornadaId)).data.repartidorId == request.auth.uid && clienteDelRepartidor(request.resource.data.clienteId)));
      allow update, delete: if false;
    }
    // creditos: cualquier autenticado puede leer/crear/editar (abonos);
    // borrar solo admin.
    match /creditos/{id} {
      allow read, create: if autenticado();
      allow update: if autenticado() && (!resource.data.keys().hasAll(['tarifaSnapshot']) || request.resource.data.tarifaSnapshot == resource.data.tarifaSnapshot);
      allow delete: if esAdmin();
    }

    // Tarifas comerciales: solo ADMIN puede configurarlas; el repartidor las
    // consume para seleccionar una tarifa puntual y nunca puede editarlas.
    match /tarifas/{id} {
      allow read: if autenticado();
      allow create, update, delete: if esAdmin();
    }

    match /cargas_agua/{id} {
      allow read: if autenticado() && (esAdmin() || resource.data.repartidorId == request.auth.uid);
      allow create: if autenticado() && getAfter(/databases/$(database)/documents/jornadas/$(request.resource.data.jornadaId)).data.aguaDisponibleLitros <= 5000 && request.resource.data.repartidorId == request.auth.uid && request.resource.data.jornadaId is string && request.resource.data.jornadaId != '' && request.resource.data.litros is number && request.resource.data.litros > 0 && getAfter(/databases/$(database)/documents/jornadas/$(request.resource.data.jornadaId)).data.estado == 'abierta' && getAfter(/databases/$(database)/documents/jornadas/$(request.resource.data.jornadaId)).data.repartidorId == request.auth.uid && request.resource.data.localidadId == getAfter(/databases/$(database)/documents/jornadas/$(request.resource.data.jornadaId)).data.localidadId && request.resource.data.vehiculoId == getAfter(/databases/$(database)/documents/jornadas/$(request.resource.data.jornadaId)).data.vehiculoId && request.resource.data.medidorId == getAfter(/databases/$(database)/documents/jornadas/$(request.resource.data.jornadaId)).data.medidorId;
      allow update, delete: if false;
    }
    match /lecturas_medidor/{id} {
      allow read: if autenticado() && (esAdmin() || resource.data.usuarioUid == request.auth.uid || get(/databases/$(database)/documents/jornadas/$(resource.data.jornadaId)).data.repartidorId == request.auth.uid);
      allow create: if autenticado() && (esAdmin() || (request.resource.data.usuarioUid == request.auth.uid && get(/databases/$(database)/documents/jornadas/$(request.resource.data.jornadaId)).data.repartidorId == request.auth.uid));
      allow update, delete: if false;
    }
    match /jornadas/{id} {
      allow read: if autenticado() && (esAdmin() || resource.data.repartidorId == request.auth.uid);
      allow create: if autenticado() && request.resource.data.aguaDisponibleLitros <= 5000 && (esAdmin() || (request.resource.data.repartidorId == request.auth.uid && localidadDelRepartidor(request.resource.data.localidadId)));
      allow update: if autenticado() && request.resource.data.aguaDisponibleLitros <= 5000 && (esAdmin() || (resource.data.repartidorId == request.auth.uid && localidadDelRepartidor(resource.data.localidadId) && request.resource.data.repartidorId == request.auth.uid && request.resource.data.lecturaAnterior == resource.data.lecturaAnterior && request.resource.data.lecturaInicial == resource.data.lecturaInicial && request.resource.data.vehiculo == resource.data.vehiculo && request.resource.data.vehiculoId == resource.data.vehiculoId && request.resource.data.medidorId == resource.data.medidorId && request.resource.data.localidadId == resource.data.localidadId && request.resource.data.unidadComercial == resource.data.unidadComercial && request.resource.data.litrosPorUnidad == resource.data.litrosPorUnidad && request.resource.data.incrementoContadorPorUnidad == resource.data.incrementoContadorPorUnidad && request.resource.data.aguaCargadaLitros >= resource.data.aguaCargadaLitros && request.resource.data.aguaDisponibleLitros >= 0 && request.resource.data.lecturaCalculadaActual >= resource.data.lecturaCalculadaActual && request.resource.data.litrosVendidosAcumulados >= resource.data.litrosVendidosAcumulados && (!resource.data.keys().hasAll(['resumenTarifas']) || request.resource.data.resumenTarifas == resource.data.resumenTarifas)));
      allow delete: if esAdmin();
    }
    // inventario_historial, devoluciones: bitácora — se puede leer y
    // crear, pero nunca editar ni borrar (registro de solo lectura una
    // vez escrito).
    match /inventario_historial/{id} {
      allow read, create: if autenticado();
      allow update, delete: if false;
    }
    match /devoluciones/{id} {
      allow read, create: if autenticado();
      allow update, delete: if false;
    }

    // cierres_caja y gastos: gerencia — cualquier autenticado puede leer/crear;
    // editar/borrar solo admin.
    match /cierres_caja/{id} {
      allow read, create: if autenticado();
      allow update, delete: if esAdmin();
    }
    match /gastos/{id} {
      allow read, create: if autenticado();
      allow update, delete: if esAdmin();
    }
    // servicios: atenciones independientes de relleno por medición. No son
    // notas de venta normales y no escriben lecturas físicas del camión.
    match /servicios/{id} {
      allow read: if autenticado() && (esAdmin() || resource.data.repartidorUid == request.auth.uid || resource.data.createdByUid == request.auth.uid);
      allow create: if autenticado() && request.resource.data.tipo == 'relleno_por_medicion' && request.resource.data.estado == 'completado' && request.resource.data.clienteId is string && request.resource.data.clienteId != '' && request.resource.data.jornadaId is string && request.resource.data.jornadaId != '' && request.resource.data.repartidorUid == request.auth.uid && request.resource.data.createdByUid == request.auth.uid && request.resource.data.medicion is map && request.resource.data.medicion.litrosRellenados is number && request.resource.data.medicion.litrosRellenados > 0 && request.resource.data.lecturaCamion is map && request.resource.data.lecturaCamion.noEsLecturaFisica == true && request.resource.data.stockMovil is map && request.resource.data.stockMovil.noModificaLecturaInicial == true && request.resource.data.stockMovil.noModificaLecturaFinal == true && get(/databases/$(database)/documents/jornadas/$(request.resource.data.jornadaId)).data.repartidorId == request.auth.uid && get(/databases/$(database)/documents/jornadas/$(request.resource.data.jornadaId)).data.estado == 'abierta' && get(/databases/$(database)/documents/jornadas/$(request.resource.data.jornadaId)).data.aguaDisponibleLitros >= request.resource.data.medicion.litrosRellenados && get(/databases/$(database)/documents/jornadas/$(request.resource.data.jornadaId)).data.lecturaCalculadaActual == request.resource.data.lecturaCamion.lecturaCalculadaAntes && get(/databases/$(database)/documents/clientes/$(request.resource.data.clienteId)).data.localidadId == request.resource.data.localidadId && request.resource.data.vehiculoId == get(/databases/$(database)/documents/jornadas/$(request.resource.data.jornadaId)).data.vehiculoId && request.resource.data.medidorId == get(/databases/$(database)/documents/jornadas/$(request.resource.data.jornadaId)).data.medidorId;
      allow update, delete: if false;
    }
    match /comprobantes/{id} {
      allow read: if autenticado() && (esAdmin() || resource.data.createdByUid == request.auth.uid);
      allow create: if autenticado() && request.resource.data.tipo == 'nota_servicio' && request.resource.data.estado == 'completado' && request.resource.data.servicioId is string && request.resource.data.servicioId != '' && request.resource.data.createdByUid == request.auth.uid && request.resource.data.pdfPath is string && request.resource.data.pdfPath != '' && request.resource.data.pdfUrl is string && request.resource.data.pdfUrl != '' && getAfter(/databases/$(database)/documents/servicios/$(request.resource.data.servicioId)).data.estado == 'completado' && getAfter(/databases/$(database)/documents/servicios/$(request.resource.data.servicioId)).data.createdByUid == request.auth.uid && getAfter(/databases/$(database)/documents/servicios/$(request.resource.data.servicioId)).data.comprobanteId == request.resource.data.comprobanteId && getAfter(/databases/$(database)/documents/servicios/$(request.resource.data.servicioId)).data.pdfPath == request.resource.data.pdfPath && getAfter(/databases/$(database)/documents/servicios/$(request.resource.data.servicioId)).data.pdfUrl == request.resource.data.pdfUrl;
      allow update, delete: if false;
    }
    // _meta: control interno. La configuración de medición es administrativa;
    // el repartidor solo puede leerla para operar y nunca modificarla.
    match /_meta/{id} {
      allow read: if autenticado();
      allow write: if esAdmin() || (autenticado() && id == 'seed');
    }
  }
}
