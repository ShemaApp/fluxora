rules_version = '2';

// Reglas de seguridad de Firestore, calcadas de las colecciones y el
// modelo de roles que ya usa la app (ver db/colecciones.js y
// sesion.js: admin / repartidor).
//
// Pega estas reglas en Firebase Console → Firestore Database → Reglas,
// o publícalas con Firebase CLI (firebase deploy --only firestore:rules).

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function esAdmin() {
      return autenticado() && perfil().role == 'admin';
    }

    function snapshotTarifaValido() {
      return !request.resource.data.keys().hasAll(['modoOperacion']) || request.resource.data.modoOperacion != 'agua_medidor' || (request.resource.data.keys().hasAll(['tarifaSnapshot']) && request.resource.data.tarifaSnapshot is map && request.resource.data.tarifaSnapshot.litrosPorUnidad > 0 && request.resource.data.tarifaSnapshot.incrementoContadorPorUnidad > 0 && request.resource.data.tarifaSnapshot.precioUnitario >= 0 && request.resource.data.tarifaSnapshot.unidadComercial is string);
    }

    // usuarios: cualquier autenticado puede leer (la app lo necesita para
    // nombres/roles); solo el propio usuario o un admin puede escribir su
    // documento; solo admin puede borrar.
    match /usuarios/{uid} {
      allow read: if autenticado();
      allow create: if autenticado() && (request.auth.uid == uid || esAdmin()) && request.resource.data.role in ['admin', 'repartidor'];
      allow update: if autenticado() && (request.auth.uid == uid || esAdmin()) && request.resource.data.role in ['admin', 'repartidor'];
      allow delete: if esAdmin();
    }

    // productos: catálogo operativo.
    match /productos/{id} {
      allow read, create, update: if autenticado();
      allow delete: if esAdmin();
    }
    match /clientes/{id} {
      // El cliente fijo es obligatorio dentro de una zona. El repartidor
      // solo puede leer y editar clientes ligados a su chofer; nunca puede
      // reasignar la zona ni el chofer.
      allow read: if autenticado() && (esAdmin() || perfil().role != 'repartidor' || resource.data.zonaChoferId == request.auth.uid);
      allow create: if esAdmin() && request.resource.data.zonaId is string && request.resource.data.zonaId != '' && request.resource.data.zonaChoferId is string && request.resource.data.zonaChoferId != '';
      allow update: if esAdmin() || (autenticado() && perfil().role == 'repartidor' && resource.data.zonaChoferId == request.auth.uid && request.resource.data.zonaId == resource.data.zonaId && request.resource.data.zonaChoferId == resource.data.zonaChoferId && request.resource.data.zonaVehiculo == resource.data.zonaVehiculo);
      allow delete: if esAdmin();
    }
    match /localidades/{id} {
      // Los nombres de localidades los define la Empresa.
      allow read: if autenticado();
      allow create, update, delete: if esAdmin();
    }
    match /zonas/{id} {
      // Una zona tiene un solo chofer operativo. Las asignaciones son
      // administrativas y el chofer solo consume sus zonas asignadas.
      allow read: if autenticado();
      allow create, update, delete: if esAdmin();
    }

    // notas, pedidos: operación diaria — cualquier autenticado puede leer
    // y crear; editar/borrar solo admin (evita que se alteren ventas ya
    // cerradas).
    match /notas/{id} {
      allow read: if autenticado() && (esAdmin() || resource.data.capturadoPorUid == request.auth.uid || resource.data.repartidorId == request.auth.uid);
      allow create: if snapshotTarifaValido() && (esAdmin() || (autenticado() && request.resource.data.capturadoPorUid == request.auth.uid && request.resource.data.jornadaId is string && request.resource.data.jornadaId != '' && get(/databases/$(database)/documents/jornadas/$(request.resource.data.jornadaId)).data.repartidorId == request.auth.uid && get(/databases/$(database)/documents/clientes/$(request.resource.data.clienteId)).data.zonaChoferId == request.auth.uid));
      allow update, delete: if false;
    }
    match /pedidos/{id} {
      allow read, create, update: if autenticado();
      allow delete: if esAdmin();
    }

    // creditos: cualquier autenticado puede leer/crear/editar (abonos);
    // borrar solo admin.
    match /creditos/{id} {
      allow read, create: if autenticado();
      allow update: if autenticado() && (!resource.data.keys().hasAll(['tarifaSnapshot']) || request.resource.data.tarifaSnapshot == resource.data.tarifaSnapshot);
      allow delete: if esAdmin();
    }

    // Tarifas comerciales: solo ADMIN puede configurarlas; el repartidor las
    // consume para seleccionar una tarifa puntual y nunca puede editarlas.
    match /tarifas/{id} {
      allow read: if autenticado();
      allow create, update, delete: if esAdmin();
    }

    // rutas: transferencias/reparto — cualquier autenticado puede
    // leer/crear/editar; borrar solo admin.
    match /lecturas_medidor/{id} {
      allow read: if autenticado() && (esAdmin() || resource.data.usuarioUid == request.auth.uid || get(/databases/$(database)/documents/jornadas/$(resource.data.jornadaId)).data.repartidorId == request.auth.uid);
      allow create: if autenticado() && (esAdmin() || (request.resource.data.usuarioUid == request.auth.uid && get(/databases/$(database)/documents/jornadas/$(request.resource.data.jornadaId)).data.repartidorId == request.auth.uid));
      allow update, delete: if false;
    }
    match /jornadas/{id} {
      allow read: if autenticado() && (esAdmin() || resource.data.repartidorId == request.auth.uid);
      allow create: if autenticado() && (esAdmin() || request.resource.data.repartidorId == request.auth.uid);
      allow update: if autenticado() && (esAdmin() || (resource.data.repartidorId == request.auth.uid && request.resource.data.repartidorId == request.auth.uid && request.resource.data.lecturaAnterior == resource.data.lecturaAnterior && request.resource.data.lecturaInicial == resource.data.lecturaInicial && request.resource.data.vehiculo == resource.data.vehiculo && request.resource.data.vehiculoId == resource.data.vehiculoId && request.resource.data.medidorId == resource.data.medidorId && request.resource.data.zonaId == resource.data.zonaId && request.resource.data.unidadComercial == resource.data.unidadComercial && request.resource.data.litrosPorUnidad == resource.data.litrosPorUnidad && request.resource.data.incrementoContadorPorUnidad == resource.data.incrementoContadorPorUnidad && request.resource.data.aguaCargadaLitros == resource.data.aguaCargadaLitros && request.resource.data.aguaDisponibleLitros >= 0 && request.resource.data.lecturaCalculadaActual >= resource.data.lecturaCalculadaActual && request.resource.data.litrosVendidosAcumulados >= resource.data.litrosVendidosAcumulados && (!resource.data.keys().hasAll(['resumenTarifas']) || request.resource.data.resumenTarifas == resource.data.resumenTarifas)));
      allow delete: if esAdmin();
    }
    match /rutas/{id} {
      allow read, create, update: if autenticado();
      allow delete: if esAdmin();
    }

    // inventario_historial, devoluciones: bitácora — se puede leer y
    // crear, pero nunca editar ni borrar (registro de solo lectura una
    // vez escrito).
    match /inventario_historial/{id} {
      allow read, create: if autenticado();
      allow update, delete: if false;
    }
    match /devoluciones/{id} {
      allow read, create: if autenticado();
      allow update, delete: if false;
    }

    // cierres_caja, gastos, ubicacion_auditoria: gerencia/auditoría —
    // cualquier autenticado puede leer/crear; editar/borrar solo admin.
    match /cierres_caja/{id} {
      allow read, create: if autenticado();
      allow update, delete: if esAdmin();
    }
    match /gastos/{id} {
      allow read, create: if autenticado();
      allow update, delete: if esAdmin();
    }
    match /ubicacion_auditoria/{id} {
      allow read, create: if autenticado();
      allow update, delete: if esAdmin();
    }

    // _meta: control interno. La configuración de medición es administrativa;
    // el repartidor solo puede leerla para operar y nunca modificarla.
    match /_meta/{id} {
      allow read: if autenticado();
      allow write: if esAdmin() || (autenticado() && id == 'seed');
    }
  }
}
